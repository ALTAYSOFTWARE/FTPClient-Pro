<Window x:Class="FTPClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTP Client Pro" Height="700" Width="1200"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#252526" Padding="10" Height="50">
            <Button Content="Site Yönet" Width="100" Background="#007ACC" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Bağlan" Width="100" Background="#28A745" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Kesildi" Width="100" Background="#DC3545" Foreground="White" Margin="0,0,5,0"/>
            <Separator Width="1" Background="#444" Margin="10,0"/>
            <TextBlock Text="Host:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="txtHost" Width="150" Height="30" Background="#2D2D2D" Foreground="#E0E0E0" Padding="5"/>
            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="txtPort" Width="80" Height="30" Background="#2D2D2D" Foreground="#E0E0E0" Padding="5" Text="21"/>
        </StackPanel>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Local Files -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Yerel Dosyalar" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox x:Name="lstLocalFiles" Background="#2D2D2D" Foreground="#E0E0E0" Height="550"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Height="40">
                    <Button Content="Yükle" Width="100" Background="#007ACC" Foreground="White"/>
                    <Button Content="Sil" Width="100" Background="#DC3545" Foreground="White" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Remote Files -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Uzak Dosyalar" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox x:Name="lstRemoteFiles" Background="#2D2D2D" Foreground="#E0E0E0" Height="550"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Height="40">
                    <Button Content="İndir" Width="100" Background="#007ACC" Foreground="White"/>
                    <Button Content="Sil" Width="100" Background="#DC3545" Foreground="White" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Transfers & Log -->
            <StackPanel Grid.Column="2" Margin="10">
                <TextBlock Text="Aktif Transferler" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox x:Name="lstTransfers" Background="#2D2D2D" Foreground="#E0E0E0" Height="250"/>
                <TextBlock Text="Log" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>
                <ListBox x:Name="lstLog" Background="#2D2D2D" Foreground="#E0E0E0" Height="280"/>
            </StackPanel>
        </Grid>
        
        <!-- Status Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#252526" Padding="10" Height="30">
            <TextBlock x:Name="lblStatus" Text="Hazır" Foreground="#E0E0E0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>