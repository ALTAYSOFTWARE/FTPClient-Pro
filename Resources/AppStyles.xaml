<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Dark Mode Theme Colors -->
    <Color x:Key="PrimaryBackground">#1E1E1E</Color>
    <Color x:Key="SecondaryBackground">#2D2D2D</Color>
    <Color x:Key="Foreground">#E0E0E0</Color>
    <Color x:Key="AccentColor">#007ACC</Color>
    <Color x:Key="SuccessColor">#28A745</Color>
    <Color x:Key="ErrorColor">#DC3545</Color>
    <Color x:Key="WarningColor">#FFB347</Color>
    
    <!-- Button Styles -->
    <Style TargetType="Button" x:Key="ModernButton">
        <Setter Property="Background" Value="#007ACC"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="32"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0099FF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#005A96"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- TextBox Styles -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="BorderBrush" Value="#444444"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    
    <!-- DataGrid Styles -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="RowBackground" Value="#2D2D2D"/>
        <Setter Property="AlternatingRowBackground" Value="#333333"/>
    </Style>
    
</ResourceDictionary>